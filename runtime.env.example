# Store the completed file as Jenkins secret file: devsync-runtime-env.
# Use URL-safe credentials here so DB_URL can contain the same password.
POSTGRES_USER=devsync
POSTGRES_DB=devsync
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
DB_URL=postgresql://devsync:REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD@postgres:5432/devsync
REDIS_URL=redis://redis:6379
MONGO_URI=mongodb://mongo:27017/devsync_chat
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN_HOURS=24
JWT_REFRESH_EXPIRES_IN_DAYS=7
FRONTEND_URL=http://YOUR_APPLICATION_SERVER_IP
PUBLIC_FRONTEND_URL=http://YOUR_APPLICATION_SERVER_IP
CHAT_SERVICE_URL=http://chat:4000
MAIN_SERVICE_URL=http://backend:5000
ELASTIC_EMAIL_API_KEY=REPLACE_ME
ELASTIC_EMAIL_FROM=you@example.com
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME
